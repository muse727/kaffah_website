generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. TABEL ADMIN (Buat Login)
// ==========================================
model Admin {
  id            Int       @id @default(autoincrement())
  name          String    @default("Admin Kaffah")
  username      String    @unique
  password      String
  role          String    @default("SUPERADMIN")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  
  // Sistem Keamanan (Brute Force):
  failedLogins  Int       @default(0)
  lockoutUntil  DateTime?
}

// ==========================================
// 2. TABEL BERITA & ARTIKEL
// ==========================================
model Berita {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String   @db.Text
  author      String   @default("Tim Redaksi")
  status      String   @default("PUBLISHED") // BISA: DRAFT / PUBLISHED
  image       String?  // Link foto sampul
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 3. TABEL DATA JUARA / PRESTASI
// ==========================================
model Juara {
  id          Int      @id @default(autoincrement())
  title       String   
  student     String   
  category    String   
  year        String   
  image       String?  
  
  // 🔥 TAMBAHAN DETAIL LENGKAP
  competition String?  // Nama Lomba Spesifik
  organizer   String?  // Penyelenggara
  location    String?  // Tempat
  date        String?  // Tanggal Lengkap
  description String?  @db.Text // Deskripsi
  achievements String? // Pencapaian (pisahkan dengan koma)
  teacher     String?  // Pembimbing

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 4. TABEL TESTIMONI WALI MURID
// ==========================================
model Testimoni {
  id        Int      @id @default(autoincrement())
  name      String
  title     String
  quote     String   @db.Text
  thumbnail String?  // Foto gede di kiri
  avatar    String?  // Foto profil kecil
  videoUrl  String?  // Link YouTube (Opsional)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tim {
  id        Int      @id @default(autoincrement())
  name      String   // Nama Lengkap
  position  String   // Jabatan (Ex: Guru Matematika)
  category  String   // Kategori (Manajemen, Guru KIS 1, dll)
  image     String?  // Foto Profil
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PengaturanHero {
  id        Int      @id @default(1)
  tipe      String   // Bakal isinya "IMAGE" atau "VIDEO"
  mediaUrl  String   // Alamat videonya/fotonya
  
  updatedAt DateTime @updatedAt
}