generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Wakaf {
  id          Int      @id @default(autoincrement())
  nama        String
  whatsapp    String
  nominal     Int
  message     String?
  unit        String?
  status      String   @default("UNPAID") // UNPAID (Belum Upload), PENDING (Sudah Upload), SUCCESS (Diterima)
  buktiBayar  String?
  createdAt   DateTime @default(now())
}

model Admin {
  id            Int       @id @default(autoincrement())
  name          String
  username      String    @unique
  password      String
  role          String    @default("SUPERADMIN")
  
  // Baris yang sempet ilang:
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  
  // Sistem Keamanan (Brute Force):
  failedLogins  Int       @default(0)
  lockoutUntil  DateTime?
}

model HasilUjian {
  id        Int      @id @default(autoincrement())
  nama      String
  juz       String?  // Ganti jadi String? (Optional) biar kalau Belum Lulus ga error
  predikat  String?  // Ganti jadi String? (Optional)
  status    String   @default("LULUS")
  posterUrl String?
  pesan     String?  // <--- TAMBAHIN INI BRO
  createdAt DateTime @default(now())
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  adminName   String   // Nama admin yang ngelakuin aksi
  action      String   // Misal: "KONFIRMASI", "HAPUS DONASI", "TAMBAH ADMIN"
  description String   @db.Text // Penjelasan detail: "Mengkonfirmasi donasi Budi Rp 100.000"
  createdAt   DateTime @default(now())
}

model KabarTerbaru {
  id        Int      @id @default(autoincrement())
  judul     String
  konten    String   @db.Text
  gambar    String?  // Opsional, kalau mau upload foto progres pembangunan
  createdAt DateTime @default(now())
}