generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Wakaf {
  id          Int      @id @default(autoincrement())
  nama        String
  whatsapp    String
  nominal     Int
  message     String?
  unit        String?
  status      String   @default("UNPAID") // UNPAID (Belum Upload), PENDING (Sudah Upload), SUCCESS (Diterima)
  buktiBayar  String?
  createdAt   DateTime @default(now())
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String // Ini nanti isinya hash (acak), bukan text biasa
}